@using System.Globalization
@using MudBlazor

<MudDatePicker @ref="_pickerRef"
               Class="@Class"
               Label="@Label"
               Color="Color"
               Variant="Variant"
               Margin="Margin"
               Disabled="Disabled"
               Editable="false"
               Clearable="Clearable"
               DisableToolbar="true"
               Culture="@PickerCulture"
               FirstDayOfWeek="DayOfWeek.Monday"
               ShowWeekNumbers="true"
               Date="@_date"
               DateChanged="OnDateChanged"
               Converter="@WeekTextConverter"
               HelperText="@ComputedHelperText"
               AutoClose="true">
    <PickerActions Context="picker">
        <MudToolBar Dense="true" Class="px-1">
            <MudButton Variant="Variant.Text" OnClick="@(() => picker.Clear())">清除</MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Text" OnClick="@(async () => await SelectThisWeekAsync(picker))">本周</MudButton>
        </MudToolBar>
    </PickerActions>
</MudDatePicker>

@code {
    private MudDatePicker? _pickerRef;
    private DateTime? _date;

    private static readonly CultureInfo PickerCulture = CultureInfo.GetCultureInfo("zh-CN");

    private static readonly Converter<DateTime?, string> WeekTextConverter = new()
    {
        SetFunc = v => v is null
            ? string.Empty
            : $"{ISOWeek.GetYear(v.Value)} 年第 {ISOWeek.GetWeekOfYear(v.Value)} 周",
        GetFunc = _ => null
    };

    /// <summary>Monday of the ISO week (time is midnight, unspecified kind).</summary>
    [Parameter] public DateTime? WeekMonday { get; set; }

    [Parameter] public EventCallback<DateTime?> WeekMondayChanged { get; set; }

    [Parameter] public string? Label { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter] public Color Color { get; set; } = Color.Primary;

    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;

    [Parameter] public Margin Margin { get; set; } = Margin.None;

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool Clearable { get; set; } = true;

    /// <summary>Overrides the default Monday–Sunday helper line when set.</summary>
    [Parameter] public string? HelperText { get; set; }

    [Parameter] public bool ShowWeekRangeHelper { get; set; } = true;

    private string? ComputedHelperText =>
        HelperText
        ?? (ShowWeekRangeHelper && _date is { } d
            ? $"{d:yyyy-MM-dd} to {d.AddDays(6):yyyy-MM-dd}"
            : null);

    protected override void OnParametersSet()
    {
        var param = WeekMonday?.Date;
        var local = _date?.Date;
        if (param != local)
        {
            _date = WeekMonday;
        }
    }

    private async Task OnDateChanged(DateTime? clicked)
    {
        var normalized = NormalizeToIsoWeekMonday(clicked);
        if (_date?.Date == normalized?.Date)
        {
            return;
        }

        _date = normalized;
        await WeekMondayChanged.InvokeAsync(_date);
    }

    private async Task SelectThisWeekAsync(MudPicker<DateTime?> picker)
    {
        _date = NormalizeToIsoWeekMonday(DateTime.Today);
        await WeekMondayChanged.InvokeAsync(_date);
        if (_pickerRef is not null && _date.HasValue)
        {
            await _pickerRef.GoToDate(_date.Value, submitDate: false);
        }

        picker.Close(false);
    }

    private static DateTime? NormalizeToIsoWeekMonday(DateTime? value)
    {
        if (value is null)
        {
            return null;
        }

        var d = value.Value.Date;
        return ISOWeek.ToDateTime(ISOWeek.GetYear(d), ISOWeek.GetWeekOfYear(d), DayOfWeek.Monday);
    }
}
